{
    "compilerOptions":  {
                            "module":  "CommonJS",
                            "moduleResolution":  "Node",
                            "target":  "ES2022",
                            "lib":  [
                                        "ES2022"
                                    ],
                            "outDir":  "lib",
                            "rootDir":  "src",
                            "strict":  true,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "sourceMap":  true,
                            "types":  [
                                          "node"
                                      ],
                            "forceConsistentCasingInFileNames":  true
                        },
    "include":  [
                    "src/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "lib",
                    "tests"
                ]
}
