rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/admins/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/admins/$(request.auth.uid)
        ).data.active == true;
    }

    match /media-templates/{competitionId}/{allPaths=**} {
      allow read:
        if true;

      allow create, update, delete:
        if isAdmin();
    }

    /*
     * ========================================================
     * SPONSOR
     * ========================================================
     *
     * Lettura pubblica dei loghi.
     * Upload/modifica/eliminazione riservati agli Admin.
     * Sono accettati soltanto file immagine fino a 5 MB.
     * ========================================================
     */

    match /sponsors/{competitionId}/{fileName} {
      allow read:
        if true;

      allow create, update:
        if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");

      allow delete:
        if isAdmin();
    }

  }
}